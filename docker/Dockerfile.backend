# Backend Torre RPA — Node + Python (Playwright) em uma imagem só.
# Motivo: executor.ts faz spawn de `scripts/<bot>/run.py`, então a imagem
# precisa de Node, Python 3.12 e Chromium no mesmo container.
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
  && rm -rf /var/lib/apt/lists /*
COPY package*.json ./
COPY apps/backend/package.json apps/backend/
COPY packages/shared/package.json packages/shared/
RUN npm ci --workspaces --ignore-scripts
COPY . .
RUN npm run build -w packages/shared
RUN npm run build -w apps/backend

FROM node:22-bookworm-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
  SCRIPTS_DIR=/app/scripts \
  DATABASE_PATH=/data/torre-rpa.db \
  PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
  && rm -rf /var/lib/apt/lists /*
COPY --from=build /app/apps/backend/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
# Scripts Python precisam estar na imagem — executor faz spawn deles
COPY --from=build /app/scripts ./scripts
COPY --from=build /app/scripts/requirements.txt ./scripts/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r ./scripts/requirements.txt \
  && python3 -m playwright install --with-deps chromium
VOLUME ["/data"]
EXPOSE 3001
CMD ["node", "dist/server.js"]
