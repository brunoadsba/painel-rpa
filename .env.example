# Backend
BACKEND_PORT=3001
DATABASE_URL=postgres://rpa:rpa@localhost:5432/torre_rpa
JWT_SECRET=change-me-in-production
# OPENPORT_MOCK=true indica se o backend deve simular a API do OpenPort.
# No UAT interno, deixar como true.
OPENPORT_MOCK=true
OPENPORT_API_URL=https://api.openport.example.com

# Frontend
VITE_API_URL=http://localhost:3001/api

# RPA Paralisação — OpenPort CODEBA
OPENPORT_URL=https://openportilheus.codeba.gov.br/openportcodeba/
OPENPORT_LOGIN=seu_usuario
OPENPORT_SENHA=sua_senha
PRIMEIRO_PLANO=true
HEADLESS=false
TIMEOUT_MS=30000
SLOW_MO_MS=300
PAUSA_VISUAL_MS=500
MANTER_ABERTO_SEG=120
ESTADIA_LABEL=
OPERADOR=30002
