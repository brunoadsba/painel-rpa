# RPA Paralisação — OpenPort CODEBA
# Copie para .env e preencha os valores reais

OPENPORT_URL=https://openportilheus.codeba.gov.br/openportcodeba/
OPENPORT_LOGIN=seu_usuario
OPENPORT_SENHA=sua_senha

# Caminho da planilha de paralisações (relativo à raiz do RPA)
PLANILHA=data/Paralisacoes_YANGTZE_QUANTUM.xlsx

# Execução do navegador
PRIMEIRO_PLANO=true
HEADLESS=false
TIMEOUT_MS=30000
SLOW_MO_MS=300
PAUSA_VISUAL_MS=500
MANTER_ABERTO_SEG=120
ESTADIA_LABEL=
OPERADOR=30002
